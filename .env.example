# GEMINI_API_KEY: Required for Gemini AI API calls (SERVER-SIDE ONLY, never prefix with VITE_).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this Express backend is hosted (e.g. Cloud Run / Render / Fly.io).
APP_URL="MY_APP_URL"

# CORS_ALLOWED_ORIGINS: Optional comma-separated origins allowed to call this Express backend
# from Android Capacitor WebView or separate web domains.
# Note: https://localhost and capacitor://localhost are allowed automatically for Capacitor apps.
CORS_ALLOWED_ORIGINS=""

# VITE_API_BASE_URL: Optional public backend URL compiled into the Capacitor Android APK.
# Leave empty on unified full-stack web hosting (uses same-origin /api/* and /ws).
# Set to your hosted Express backend URL (e.g. https://beatlabz-api.example.com) when building Android APK.
VITE_API_BASE_URL=""
